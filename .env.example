# ============================================================
# SeedUp 통합 .env
#
# 사용법:
#   cp .env.example .env.local
#   그리고 아래 값들을 채운 뒤 프론트 / 라우터 / 백엔드를 실행.
#
# 이 한 파일을 세 프로세스가 함께 읽는다:
#   1) 프론트엔드 (Next.js)  — 자동으로 SeedUp/.env.local 읽음
#   2) 라우터 (SeedUp/router) — python-dotenv 로 이 파일을 읽음
#   3) SeedUp backend (로드맵 어댑터) — runtime.py 가 이 파일을 함께 읽음
#
# 브라우저에 노출되는 값은 오직 NEXT_PUBLIC_ 접두어가 붙은 것들뿐이다.
# 나머지는 서버 프로세스에서만 사용된다.
# ============================================================


# ────────────────────────────────────────────────────────────
# ① 프론트엔드 (Next.js)
# ────────────────────────────────────────────────────────────

# "mock" | "live"
#   - mock: services/mockData.ts / mockRoadmapData.ts 로 로컬 렌더
#   - live: 아래 NEXT_PUBLIC_API_BASE / NEXT_PUBLIC_ROADMAP_API_URL 로 실제 호출
NEXT_PUBLIC_API_MODE=live

# 챗(/chat) 이 붙을 base URL.
# 통합 상담을 라우터 경유로 붙일 거면 라우터 포트(8030), 아니면 BenefitUp 직결(8010).
NEXT_PUBLIC_API_BASE=http://localhost:8030

# 로드맵 단독 화면(/roadmap) 이 붙을 SeedUp backend.
NEXT_PUBLIC_ROADMAP_API_URL=http://localhost:8001


# ────────────────────────────────────────────────────────────
# ② 라우터 (SeedUp/router)
# ────────────────────────────────────────────────────────────

# 하위 에이전트 HTTP 엔드포인트.
BENEFIT_API=http://localhost:8010
ROADMAP_API=http://localhost:8020

# 라우터 LLM (Gemini). GEMINI_API_KEY 하나로 라우터·백엔드가 공용.
GOOGLE_API_KEY=
ROUTER_MODEL=gemini-2.5-flash

# 브라우저에서 라우터를 부를 origin. 프론트가 다른 포트라면 여기 추가.
CORS_ORIGINS=http://localhost:3000

# 하위 에이전트 타임아웃(초). 대부분 기본값 유지.
BENEFIT_TIMEOUT=60
ROADMAP_TIMEOUT=60


# ────────────────────────────────────────────────────────────
# ③ SeedUp backend (로드맵 어댑터) — /roadmap 화면을 직접 띄울 때만 필요
# ────────────────────────────────────────────────────────────

# 규칙만으로 해석하지 못한 채팅을 (숫자·금액 마스킹 후) Gemini 계획기로 넘길지.
ENABLE_GEMINI_PLANNER=false
ENABLE_VECTOR_RAG=false
ENABLE_GEMINI=false

GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=1536

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
