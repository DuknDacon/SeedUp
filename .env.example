# ============================================================
# SeedUp .env
#
# 사용법:
#   cp .env.example .env.local
#   그리고 아래 값들을 채운 뒤 프론트 / 라우터를 실행.
#
# 이 파일을 두 프로세스가 함께 읽는다:
#   1) 프론트엔드 (Next.js)  — 자동으로 SeedUp/.env.local 읽음
#   2) 라우터 (SeedUp/router) — python-dotenv 로 이 파일을 읽음
#
# 로드맵 백엔드(FastAPI) 와 그 크레덴셜(POSTGRES / GEMINI) 은
# Roadmap-Agent 레포가 자기 .env 로 관리한다 — 여기엔 두지 않는다.
# BenefitUp-Agent 도 동일하게 자기 .env 를 자기 것으로 소유.
#
# 브라우저에 노출되는 값은 오직 NEXT_PUBLIC_ 접두어가 붙은 것들뿐이다.
# 나머지는 서버 프로세스에서만 사용된다.
# ============================================================


# ────────────────────────────────────────────────────────────
# ① 프론트엔드 (Next.js)
# ────────────────────────────────────────────────────────────

# "mock" | "live"
#   - mock: services/mockData.ts / mockRoadmapData.ts 로 로컬 렌더
#   - live: 아래 NEXT_PUBLIC_API_BASE / NEXT_PUBLIC_ROADMAP_API_URL 로 실제 호출
NEXT_PUBLIC_API_MODE=live

# 챗(/chat) 이 붙을 base URL.
# 통합 상담을 라우터 경유로 붙일 거면 라우터 포트(8030), 아니면 BenefitUp 직결(8010).
NEXT_PUBLIC_API_BASE=http://localhost:8030

# 로드맵 단독 화면(/roadmap) 이 붙을 Roadmap-Agent 컨테이너.
# docker compose -f ../Roadmap-Agent/docker-compose.roadmap.yml up 으로 띄움.
NEXT_PUBLIC_ROADMAP_API_URL=http://localhost:8001


# ────────────────────────────────────────────────────────────
# ② 라우터 (SeedUp/router)
# ────────────────────────────────────────────────────────────

# 하위 에이전트 HTTP 엔드포인트.
BENEFIT_API=http://localhost:8010
ROADMAP_API=http://localhost:8001

# 라우터 자신의 LLM (Gemini). Roadmap-Agent 의 GEMINI_API_KEY 와는 별개.
GOOGLE_API_KEY=
ROUTER_MODEL=gemini-3.5-flash-lite

# 브라우저에서 라우터를 부를 origin. 프론트가 다른 포트라면 여기 추가.
CORS_ORIGINS=http://localhost:3000

# 하위 에이전트 타임아웃(초). 대부분 기본값 유지.
BENEFIT_TIMEOUT=60
ROADMAP_TIMEOUT=60
