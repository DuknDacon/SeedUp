# API 모드
# - "mock": services/mockData.ts, services/mockRoadmapData.ts 를 그대로 사용 (기본값)
# - "live": NEXT_PUBLIC_API_BASE / NEXT_PUBLIC_ROADMAP_API_URL 로 실제 API 호출
NEXT_PUBLIC_API_MODE=mock

# BenefitUp-Agent FastAPI 래퍼 주소 (live 모드일 때만 사용)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Roadmap-Agent FastAPI 주소 (live 모드일 때만 사용)
NEXT_PUBLIC_ROADMAP_API_URL=http://localhost:8001
